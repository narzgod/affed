{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/owner",
      "destination": "/api/gate?p="
    },
    {
      "source": "/owner/:path*",
      "destination": "/api/gate?p=:path*"
    }
  ],
  "functions": {
    "api/gate.js": {
      "includeFiles": "private/**",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}